      "Image": {
        "type": "object",
        "description": "Serializer for Image model.\n\nReturns complete image information including all generated variants.\nVariants are auto-generated in WebP format for optimal compression.",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "file_hash": {
            "type": "string",
            "readOnly": true,
            "description": "SHA-256 hash of the original file"
          },
          "original_filename": {
            "type": "string",
            "maxLength": 255
          },
          "file_extension": {
            "type": "string",
            "maxLength": 10
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TypeEnum"
              }
            ],
            "readOnly": true,
            "default": "product",
            "description": "Image type — validated against STAPEL_CDN['ASSET_TYPES'] (default ('avatar',); the historical 'product' default value here is only in scope for host projects that still add it).\n\n* `avatar` - Avatar"
          },
          "prefix": {
            "type": "string",
            "readOnly": true,
            "description": "URL prefix: <type>/<hash>"
          },
          "original_width": {
            "type": "integer",
            "readOnly": true
          },
          "original_height": {
            "type": "integer",
            "readOnly": true
          },
          "original_size": {
            "type": "integer",
            "readOnly": true,
            "description": "File size in bytes"
          },
          "original_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "URL to original uploaded image"
          },
          "variant_16_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "16px micro thumbnail, min-side (WebP)"
          },
          "variant_32_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "32px thumbnail, min-side (WebP)"
          },
          "variant_64_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "64px thumbnail, min-side (WebP)"
          },
          "variant_120_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "120px thumbnail, min-side (WebP)"
          },
          "variant_160_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "160px preview, w-branch (WebP)"
          },
          "variant_240_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "240px preview, w-branch (WebP)"
          },
          "variant_480_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "480px preview, w-branch (WebP)"
          },
          "variant_560_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "560px preview, w-branch (WebP)"
          },
          "variant_720_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "720px preview, w-branch (WebP)"
          },
          "variant_1080_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "1080px preview, w-branch (WebP)"
          },
          "variant_1440_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "1440px 2K (WebP)"
          },
          "variant_2160_url": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "2160px 4K (WebP)"
          },
          "variants_meta": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "integer"
                },
                "branch": {
                  "type": "string",
                  "enum": [
                    "w",
                    "h"
                  ],
                  "nullable": true,
                  "description": "None for thumbnail-class (min-side) tiers."
                },
                "url": {
                  "type": "string"
                },
                "width": {
                  "type": "integer"
                },
                "height": {
                  "type": "integer"
                }
              },
              "required": [
                "tier",
                "url",
                "width",
                "height"
              ]
            },
            "readOnly": true,
            "description": "Generated variants with geometry: [{tier, branch, url, width, height}]"
          },
          "variants_status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VariantsStatusEnum"
              }
            ],
            "readOnly": true,
            "description": "'pending' — variant generation has not completed, every variant_<size>_url in this payload is a prediction; 'ready' — the ladder exists and the URLs resolve.\n\n* `pending` - pending\n* `ready` - ready"
          },
          "variants_ready_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "nullable": true,
            "description": "When variant generation completed; null while pending."
          },
          "is_processed": {
            "type": "boolean",
            "readOnly": true,
            "description": "Whether variants have been generated"
          },
          "uploaded_by": {
            "type": "string",
            "format": "uuid",
            "readOnly": true,
            "nullable": true
          },
          "uploaded_by_username": {
            "type": "string",
            "readOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "created_at",
          "file_extension",
          "file_hash",
          "id",
          "is_processed",
          "original_filename",
          "original_height",
          "original_size",
          "original_url",
          "original_width",
          "prefix",
          "type",
          "updated_at",
          "uploaded_by",
          "uploaded_by_username",
          "variant_1080_url",
          "variant_120_url",
          "variant_1440_url",
          "variant_160_url",
          "variant_16_url",
          "variant_2160_url",
          "variant_240_url",
          "variant_32_url",
