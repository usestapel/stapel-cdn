      "RefSyncRequest": {
        "type": "object",
        "description": "CDN reference sync request.",
        "properties": {
          "service": {
            "type": "string",
            "description": "Service name",
            "example": "auth"
          },
          "entity_type": {
            "type": "string",
            "description": "Entity type",
            "example": "profile"
          },
          "entity_id": {
            "type": "string",
            "description": "Entity identifier",
            "example": 464
          },
          "old_hashes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Previous media references",
            "example": [
              "product/hash1",
              "product/hash2"
            ]
          },
          "new_hashes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Current media references",
            "example": [
              "product/hash2",
              "product/hash3"
            ]
          }
        },
        "required": [
          "entity_id",
          "entity_type",
          "new_hashes",
          "old_hashes",
          "service"
        ]
      },
      "RefSyncResponse": {
        "type": "object",
        "description": "CDN reference sync result.",
        "properties": {
          "added": {
            "type": "integer",
            "description": "Number of refs added",
            "example": 1
          },
          "removed": {
            "type": "integer",
            "description": "Number of refs removed",
            "example": 1
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of unresolved media references",
            "example": [
              "product/nonexistent"
            ]
          }
        },
        "required": [
          "added",
          "errors",
          "removed"
        ]
      },
