          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StapelError"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StapelError"
                }
              }
            },
            "description": ""
          }
        }
