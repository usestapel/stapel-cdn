  "components": {
    "schemas": {
      "FileExists": {
        "type": "object",
        "description": "Serializer for file existence check by hash.",
        "properties": {
          "file_hash": {
            "type": "string",
            "description": "SHA-256 hash of the file content (64 hex characters)",
            "maxLength": 64
          }
        },
        "required": [
          "file_hash"
        ]
      },
      "FileExistsResponse": {
        "type": "object",
        "description": "File existence check result.",
        "properties": {
          "file": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Image"
              },
              {
                "$ref": "#/components/schemas/Video"
              },
              {
                "$ref": "#/components/schemas/FileModel"
              }
            ],
            "nullable": true,
            "description": "File object if found, null otherwise"
          },
          "exists": {
            "type": "boolean",
            "description": "Whether the file exists",
            "example": true
          },
          "type": {
            "type": "string",
            "nullable": true,
            "description": "File type if found (image or video)",
            "example": "image"
          }
        },
        "required": [
          "exists",
          "file",
          "type"
        ]
      },
      "FileModel": {
        "type": "object",
        "description": "Serializer for File model.",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "file_hash": {
            "type": "string",
            "readOnly": true,
            "description": "SHA-256 hash of the original file"
          },
          "original_filename": {
            "type": "string",
            "maxLength": 255
          },
          "file_extension": {
            "type": "string",
            "maxLength": 10
          },
